@model InscricaoFormViewModel
@{
    ViewData["Title"] = "Inscrição";
}

@section Styles {
    <link rel="stylesheet" href="~/css/inscricao.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/inscricao.js" asp-append-version="true" defer></script>
}

<main>
  <section id="inscricao">
    <span class="subtitulo">· participe </span>
    <h1 class="titulo-formulario">Inscrição</h1>
    <p class="subtitulo-formulario">
      Preencha os dados abaixo para garantir sua vaga nos eventos da Associação Negra Visão
    </p>

    @if (!string.IsNullOrEmpty(Model.CodigoConfirmado))
    {
        <div class="card-formulario" style="border-left: 6px solid var(--verde); background: #eefaf2; margin-bottom: 2rem;">
          <span style="color: var(--verde); font-weight: 800; text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.8rem;">
            ✓ Inscrição Confirmada (RF11 / RN22)
          </span>
          <h2 style="font-family: var(--font-space); font-size: 1.8rem; margin-top: 0.4rem;">
            @Model.EventoConfirmadoTitulo
          </h2>
          <p style="color: var(--marrom); font-weight: 600; margin-top: 0.25rem;">
            @Model.EventoConfirmadoMeta
          </p>
          <div style="margin-top: 1rem; padding: 1rem; background: #fff; border: 1px dashed var(--verde);">
            <span style="font-size: 0.85rem; text-transform: uppercase; font-weight: 700;">Código Único da Inscrição:</span>
            <strong style="display: block; font-size: 1.6rem; color: var(--verde); letter-spacing: 0.08em; margin-top: 0.2rem;">
              @Model.CodigoConfirmado
            </strong>
            <small style="color: var(--marrom);">Guarde este código para apresentação e confirmação de presença no evento.</small>
          </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.MensagemErro))
    {
        <div class="card-formulario" style="border-left: 6px solid var(--vermelho); background: #fde8e8; margin-bottom: 1.5rem;">
          <strong style="color: var(--vermelho);">@Model.MensagemErro</strong>
        </div>
    }

    <div class="card-formulario">
      <div id="aviso-mascara-cpf" style="display: none; margin-bottom: 1.25rem; padding: 0.9rem 1rem; background: #fff8e6; border-left: 4px solid var(--amarelo); font-size: 0.92rem;">
        <strong>Cadastro localizado por CPF (RN27–RN28):</strong> Seus dados são exibidos protegidos por máscaras (<code>*</code>). Mantenha os campos mascarados que não deseja alterar ou digite o valor completo novo para atualizá-los.
      </div>

      <form asp-controller="Inscricao" asp-action="Salvar" method="post" id="inscricao-formulario" novalidate>
        @Html.AntiForgeryToken()

        <!-- BLOCO 01: EVENTO -->
        <div class="form-bloco">
          <div class="form-bloco-cabecalho">
            <span class="form-bloco-numero">01</span>
            <span class="form-bloco-titulo">Evento</span>
          </div>
          <div class="campo-formulario campo-formulario-full">
            <label for="evento">Selecione o Evento *</label>
            <select id="evento" class="obrigatorio" name="EventoId" required>
              <option value="">Escolha um evento disponível</option>
              @foreach (var ev in Model.EventosDisponiveis)
              {
                  if (ev.InscricoesAbertas)
                  {
                      <option value="@ev.EventoId" selected="@(Model.EventoId == ev.EventoId ? "selected" : null)">
                        @ev.Titulo — @ev.TipoEvento (@ev.DataExibicao · @ev.VagasDisponiveis vagas)
                      </option>
                  }
                  else
                  {
                      <option value="@ev.EventoId" disabled>
                        @ev.Titulo — Indisponível/Lotado
                      </option>
                  }
              }
            </select>
            <p class="mensagem-erro"></p>
          </div>
        </div>

        <!-- BLOCO 02: DADOS PESSOAIS -->
        <div class="form-bloco">
          <div class="form-bloco-cabecalho">
            <span class="form-bloco-numero">02</span>
            <span class="form-bloco-titulo">Seus dados</span>
          </div>
          <div class="form-grade form-grade-dois">
            <div class="campo-formulario">
              <label for="cpf">CPF *</label>
              <input
                type="text"
                id="cpf"
                class="obrigatorio"
                name="Cpf"
                value="@Model.Cpf"
                placeholder="000.000.000-00"
                inputmode="numeric"
                autocomplete="off"
                required
              />
              <p class="mensagem-erro" id="erro-cpf"></p>
            </div>

            <div class="campo-formulario">
              <label for="nome">Nome completo *</label>
              <input
                type="text"
                id="nome"
                class="obrigatorio"
                name="Nome"
                value="@Model.Nome"
                placeholder="Seu nome completo"
                autocomplete="name"
                required
              />
              <p class="mensagem-erro"></p>
            </div>

            <div class="campo-formulario">
              <label for="dataNascimento">Data de nascimento *</label>
              <input
                type="date"
                id="dataNascimento"
                class="obrigatorio"
                name="DataNascimento"
                value="@Model.DataNascimento"
                autocomplete="bday"
                required
              />
              <p class="mensagem-erro"></p>
            </div>

            <div class="campo-formulario">
              <label for="telefone">Telefone (com DDD — opcional)</label>
              <input
                type="tel"
                id="telefone"
                name="Telefone"
                value="@Model.Telefone"
                placeholder="(11) 90000-0000"
                autocomplete="tel"
              />
              <p class="mensagem-erro"></p>
            </div>

            <div class="campo-formulario campo-formulario-full">
              <label for="email">E-mail (opcional)</label>
              <input
                type="email"
                id="email"
                name="Email"
                value="@Model.Email"
                placeholder="seu@email.com"
                autocomplete="email"
              />
              <p class="mensagem-erro"></p>
            </div>
          </div>
        </div>

        <!-- BLOCO 03: ENDEREÇO -->
        <div class="form-bloco">
          <div class="form-bloco-cabecalho">
            <span class="form-bloco-numero">03</span>
            <span class="form-bloco-titulo">Endereço</span>
          </div>
          <div class="form-grade form-grade-dois">
            <div class="campo-formulario">
              <label for="cep">CEP *</label>
              <input
                type="text"
                id="cep"
                class="obrigatorio"
                name="Cep"
                value="@Model.Cep"
                placeholder="00000-000"
                inputmode="numeric"
                autocomplete="postal-code"
                required
              />
              <p class="mensagem-erro" id="status-cep"></p>
            </div>

            <div class="campo-formulario">
              <label for="cidade">Município *</label>
              <input
                type="text"
                id="cidade"
                class="obrigatorio"
                name="Municipio"
                value="@Model.Municipio"
                placeholder="Sua cidade"
                autocomplete="address-level2"
                required
              />
              <p class="mensagem-erro"></p>
            </div>

            <div class="campo-formulario">
              <label for="bairro">Bairro *</label>
              <input
                type="text"
                id="bairro"
                class="obrigatorio"
                name="Bairro"
                value="@Model.Bairro"
                placeholder="Seu bairro"
                required
              />
              <p class="mensagem-erro"></p>
            </div>

            <div class="campo-formulario">
              <label for="uf">UF *</label>
              <input
                type="text"
                id="uf"
                class="obrigatorio"
                name="Uf"
                value="@Model.Uf"
                placeholder="SP"
                maxlength="2"
                autocomplete="address-level1"
                required
              />
              <p class="mensagem-erro"></p>
            </div>

            <div class="campo-formulario">
              <label for="rua">Logradouro (Rua/Av.) *</label>
              <input
                type="text"
                id="rua"
                class="obrigatorio"
                name="Logradouro"
                value="@Model.Logradouro"
                placeholder="Nome da rua ou avenida"
                autocomplete="address-line1"
                required
              />
              <p class="mensagem-erro"></p>
            </div>

            <div class="campo-formulario">
              <label for="numero">Número (ou S/N) *</label>
              <input
                type="text"
                id="numero"
                class="obrigatorio"
                name="NumeroImovel"
                value="@Model.NumeroImovel"
                placeholder="Ex.: 120 ou S/N"
                autocomplete="address-line2"
                required
              />
              <p class="mensagem-erro"></p>
            </div>

            <div class="campo-formulario campo-formulario-full">
              <label for="complemento">Complemento (opcional)</label>
              <input
                type="text"
                id="complemento"
                name="Complemento"
                value="@Model.Complemento"
                placeholder="Apto, bloco, referência (opcional)"
              />
              <p class="mensagem-erro"></p>
            </div>
          </div>
        </div>

        <div class="campo-formulario">
          <button type="submit" id="buttonInscrever">
            Confirmar Inscrição no Evento
          </button>
        </div>
      </form>
    </div>
  </section>
</main>
