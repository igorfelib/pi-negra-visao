<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Negra Visão</title>
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
  </head>
  <body>
    <header>
      <div>
        <a asp-controller="Home" asp-action="Index" class="direita" id="logo">
          <img src="~/img/logo_sem_nome.svg" alt="logo negra visão" />
          <span>Negra visão</span>
        </a>
        <button class="menu-toggle" type="button" aria-label="Abrir menu" aria-expanded="false">
          <span class="menu-toggle-bar"></span>
          <span class="menu-toggle-bar"></span>
          <span class="menu-toggle-bar"></span>
        </button>
        <nav id="site-nav">
          @if (IsSectionDefined("NavItems"))
          {
              @await RenderSectionAsync("NavItems", required: false)
          }
          else
          {
              <ul>
                <li><a href="@Url.Action("Index", "Home")#hero">Home</a></li>
                <li><a href="@Url.Action("Index", "Home")#quem-somos">Quem somos</a></li>
                <li><a href="@Url.Action("Index", "Home")#eventos">Eventos</a></li>
                <li><a href="@Url.Action("Index", "Home")#memorial-negro">Museu</a></li>
                <li><a href="@Url.Action("Index", "Home")#biblioteca">Biblioteca</a></li>
                <li><a asp-controller="Inscricao" asp-action="Index">Inscrição</a></li>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li><a asp-controller="Admin" asp-action="Index">Painel Admin</a></li>
                }
                else
                {
                    <li><a asp-controller="Login" asp-action="Index">Área Interna</a></li>
                }
              </ul>
          }
        </nav>
      </div>
    </header>

    @RenderBody()

    <footer>
      @if (ViewData["OcultarFooterAlto"] as bool? != true)
      {
          <div id="footer-alto">
            <div class="footer-container">
              <h3>Negra Visão</h3>
              <p>
                Associação cultural sem fins lucrativos dedicada à difusão da
                cultura preta, fortalecimento da identidade negra e combate ao
                racismo em Atibaia-SP.
              </p>
            </div>
            <div class="footer-container footer-container-social">
              <h3>Redes Sociais</h3>
              <div>
                <a href="#" aria-label="Facebook">
                  <svg width="24" height="24" xmlns="http://www.w3.org/2000/svg" class="icon-social" viewBox="0 0 512 512" fill="currentColor">
                    <path d="M480 257.35c0-123.7-100.3-224-224-224s-224 100.3-224 224c0 111.8 81.9 204.47 189 221.29V322.12h-56.89v-64.77H221V208c0-56.13 33.45-87.16 84.61-87.16 24.51 0 50.15 4.38 50.15 4.38v55.13H327.5c-27.81 0-36.51 17.26-36.51 35v42h62.12l-9.92 64.77H291v156.54c107.1-16.81 189-109.48 189-221.31z" fill-rule="evenodd" />
                  </svg>
                </a>
                <a href="#" aria-label="Instagram">
                  <svg width="24" height="24" xmlns="http://www.w3.org/2000/svg" class="icon-social" viewBox="0 0 512 512" fill="currentColor">
                    <path d="M349.33 69.33a93.62 93.62 0 0193.34 93.34v186.66a93.62 93.62 0 01-93.34 93.34H162.67a93.62 93.62 0 01-93.34-93.34V162.67a93.62 93.62 0 0193.34-93.34h186.66m0-37.33H162.67C90.8 32 32 90.8 32 162.67v186.66C32 421.2 90.8 480 162.67 480h186.66C421.2 480 480 421.2 480 349.33V162.67C480 90.8 421.2 32 349.33 32z" />
                    <path d="M377.33 162.67a28 28 0 1128-28 27.94 27.94 0 01-28 28zM256 181.33A74.67 74.67 0 11181.33 256 74.75 74.75 0 01256 181.33m0-37.33a112 112 0 10112 112 112 112 0 00-112-112z" />
                  </svg>
                </a>
              </div>
            </div>
            <div class="footer-container">
              <h3>Parceiros e Apoiadores</h3>
              <ul>
                <li>Prefeitura de Atibaia</li>
                <li>Secretaria de Cultura</li>
                <li>Comunidade Negra de Atibaia</li>
              </ul>
            </div>
          </div>
      }
      <div id="footer-baixo">
        <p>&#169; 2026 Negra Visão - Todos os direitos reservados</p>
        <p>Atibaia, São Paulo</p>
      </div>
    </footer>

    <script src="~/js/script.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
  </body>
</html>
