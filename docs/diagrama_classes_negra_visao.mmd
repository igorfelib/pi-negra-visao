---
title: Negra Visão — Diagrama de classes de domínio
---
classDiagram
    direction TB

    class Pessoa {
        + PessoaId : int
        + Nome : string
        + Cpf : string
        + DataNascimento : DateTime
        + Email : string
        + Telefone : string
        + Situacao : string
    }

    class Endereco {
        + EnderecoId : int
        + PessoaId : int
        + Cep : string
        + Logradouro : string
        + NumeroImovel : string
        + Complemento : string
        + Bairro : string
        + Municipio : string
        + Uf : string
    }

    class Papel {
        + PapelId : int
        + NomePapel : string
    }

    class PessoaPapel {
        + PessoaId : int
        + PapelId : int
    }

    class UsuarioInterno {
        + UsuarioInternoId : int
        + PessoaId : int
        + Login : string
        + Senha : string
        + SituacaoAcesso : string
    }

    class Responsavel {
        + ResponsavelId : int
        + PessoaId : int
        + DescricaoAtuacao : string
    }

    class Evento {
        + EventoId : int
        + Titulo : string
        + Descricao : string
        + TipoEvento : string
        + Local : string
        + Classificacao : string
        + Frequencia : string
        + ModalidadeDuracao : string
        + QuantidadeTotalOcorrencias : uint
        + DataFinal : DateTime
        + Capacidade : uint
        + DataHoraAberturaInscricao : DateTime
        + DataHoraEncerramentoInscricao : DateTime
        + LimiteFaltasConsecutivas : uint
        + EstadoEvento : string
        + Visibilidade : string
        + MotivoCancelamento : string
    }

    class EventoResponsavel {
        + EventoId : int
        + ResponsavelId : int
    }

    class Ocorrencia {
        + OcorrenciaId : int
        + EventoId : int
        + DataHoraInicio : DateTime
        + DataHoraFim : DateTime
        + Cancelada : bool
        + ListaPresencaFinalizada : bool
    }

    class Inscricao {
        + InscricaoId : int
        + PessoaId : int
        + EventoId : int
        + CodigoInscricao : string
        + Estado : string
        + MotivoCancelamento : string
        + FaltasConsecutivas : uint
    }

    class Presenca {
        + PresencaId : int
        + InscricaoId : int
        + OcorrenciaId : int
        + SituacaoPresenca : string
    }

    Pessoa "1" -- "0..1" Endereco : possui
    Pessoa "1" -- "0..1" UsuarioInterno : possui acesso
    Pessoa "1" -- "0..1" Responsavel : possui cadastro
    Pessoa "1" -- "0..*" PessoaPapel : recebe
    Papel "1" -- "0..*" PessoaPapel : classifica
    Responsavel "1" -- "0..*" EventoResponsavel : assume
    Evento "1" -- "0..*" EventoResponsavel : vincula
    Pessoa "1" -- "0..*" Inscricao : realiza
    Evento "1" -- "0..*" Inscricao : recebe
    Evento "1" -- "0..*" Ocorrencia : possui
    Inscricao "1" -- "0..*" Presenca : possui registros
    Ocorrencia "1" -- "0..*" Presenca : possui registros
